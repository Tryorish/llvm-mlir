# RUN: toyc-ch7 %s -emit=mlir 2>&1 | FileCheck %s

def main() {
  var a<2, 2> = [[1, 2], [3, 4]];
  var b<2, 2> = [[5, 6], [7, 8]];
  var c = matmul(a, b);
  print(c);
}

# CHECK-LABEL: toy.func @main() {
# CHECK-NEXT:    [[VAL_0:%.*]] = toy.constant dense<{{\[\[}}1.000000e+00, 2.000000e+00], [3.000000e+00, 4.000000e+00]]> : tensor<2x2xf64>
# CHECK-NEXT:    [[VAL_1:%.*]] = toy.reshape([[VAL_0]] : tensor<2x2xf64>) to tensor<2x2xf64>
# CHECK-NEXT:    [[VAL_2:%.*]] = toy.constant dense<{{\[\[}}5.000000e+00, 6.000000e+00], [7.000000e+00, 8.000000e+00]]> : tensor<2x2xf64>
# CHECK-NEXT:    [[VAL_3:%.*]] = toy.reshape([[VAL_2]] : tensor<2x2xf64>) to tensor<2x2xf64>
# CHECK-NEXT:    [[VAL_4:%.*]] = toy.matmul [[VAL_1]], [[VAL_3]] : tensor<2x2xf64>, tensor<2x2xf64> to tensor<*xf64>
# CHECK-NEXT:    toy.print [[VAL_4]] : tensor<*xf64>
# CHECK-NEXT:    toy.return
# CHECK-NEXT:  }