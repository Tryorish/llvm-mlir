# RUN: toyc-ch7 %s -emit=mlir 2>&1 | FileCheck %s

def main() {
  var a<2, 2> = [[1, 2], [3, 4]];
  var b = neg(a);
  print(b);
}

# CHECK-LABEL: toy.func @main() {
# CHECK-NEXT:    [[VAL_0:%.*]] = toy.constant dense<{{\[\[}}1.000000e+00, 2.000000e+00], [3.000000e+00, 4.000000e+00]]> : tensor<2x2xf64>
# CHECK-NEXT:    [[VAL_1:%.*]] = toy.reshape([[VAL_0]] : tensor<2x2xf64>) to tensor<2x2xf64>
# CHECK-NEXT:    [[VAL_2:%.*]] = toy.neg [[VAL_1]] : tensor<2x2xf64> to tensor<*xf64>
# CHECK-NEXT:    toy.print [[VAL_2]] : tensor<*xf64>
# CHECK-NEXT:    toy.return
# CHECK-NEXT:  }